# PlatformIO (bawaan)
.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Sampah macOS dan Python
.DS_Store
__pycache__/
*.pyc

# Rahasia: kata sandi Wi-Fi, kunci MQTT atau Supabase. Jangan pernah dikomit.
# Buat salinan contoh kosong bernama secrets.example.h (yang itu boleh dikomit).
secrets.h
*secrets*.h
!secrets.example.h
.env
.env.*
*credentials*

# Log mentah yang bercampur karakter acak (bukan dokumen)
.vscode/readme.md

# PDF besar disimpan lokal saja
dokumentasi/referensi/rencana-awal/*.pdf
dokumentasi/referensi/paper/*.pdf

# Cadangan isi flash ESP (bisa memuat setelan Wi-Fi), jangan dikomit
arsip-firmware/*.bin

# Salinan kode tim (MQTT/backend) untuk dianalisis; bukan kode kita, jangan dikomit tanpa izin pemiliknya
kode-tim/

# Log serial hasil pio device monitor (muncul tiap sesi). Log bukti uji yang penting: git add -f logs/namafile.log
logs/
